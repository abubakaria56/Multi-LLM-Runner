# Which provider serves the models: openrouter, kong, or auto (per-model routing)
LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# Kong LLM gateway (only needed when LLM_PROVIDER is kong or auto)
KONG_API_KEY=
API_GATEWAY_KEY=
AUTH_TOKEN=
KONG_API_BASE_URL=

# Optional: comma-separated default models when the client selects none
# ENABLED_MODELS=GPT 4o,Gemini 2.5 Pro
